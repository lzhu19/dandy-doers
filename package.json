{
  "name": "dandy-doers",
  "version": "1.0.0",
  "description": "Group Name: Dandy Doers",
  "homepage": "https://github.com/lzhu19/dandy-doers#readme",
  "bugs": {
    "url": "https://github.com/lzhu19/dandy-doers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzhu19/dandy-doers.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "lint": "eslint ."
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  }
}
